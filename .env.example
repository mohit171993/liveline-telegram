# Copy to .env and fill in. Never commit .env.
# The admin id and channel id below are the owner's defaults. The app still
# reads them only from the environment — change them here if you fork the project.

# Telegram
# Local demo token. It contains MOCK so the bot will not call Telegram.
# Replace with the real @LiveLineProBot token from BotFather before production.
TELEGRAM_BOT_TOKEN=0000000000:MOCKLOCALTOKEN
# Numeric Telegram user id of @fantzoSportsUpdates. Comma-separate more ids or @usernames.
ADMIN_TELEGRAM_IDS=8992664481
# Optional extra chat (group or channel) that also receives registration and ops alerts.
ADMIN_ALERT_CHAT_ID=
# @LiveLine_Pro — bot is an admin there with permission to post.
CHANNEL_ID=-1004458549838
CHANNEL_USERNAME=LiveLine_Pro
WEBAPP_URL=http://localhost:5173
# Max age of Telegram initData auth_date, in seconds.
AUTH_MAX_AGE_SECONDS=86400

# Data
DATABASE_URL=postgresql://liveline:liveline@localhost:5432/liveline
REDIS_URL=redis://localhost:6379

# Cricket data. Leave USE_MOCK_PROVIDER=true to run the live simulator without keys.
USE_MOCK_PROVIDER=true
ROANUZ_PROJECT_KEY=
ROANUZ_API_KEY=
ROANUZ_BASE_URL=https://api.sports.roanuz.com/v5
# Socket.IO endpoint documented by Roanuz for match push.
ROANUZ_WS_URL=http://socket.sports.roanuz.com/cricket
ROANUZ_RPS=2
SIM_TICK_MS=8000

# AI match buddy. Empty key = sports-only stub grounded in the live match.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=12

# GiftPort (https://giftport.in/api/giftcard). Mock is the default.
# Whitelist this server's static egress IP in GiftPort → API Settings.
USE_MOCK_GIFTPORT=true
GIFTPORT_CLIENT_ID=
GIFTPORT_SECRET_ID=
GIFTPORT_API_URL=https://giftport.in/api/giftcard
# Optional HTTP proxy when the process itself does not have the whitelisted IP.
GIFTPORT_PROXY_URL=
GIFTPORT_LOW_BALANCE_INR=1000

# 32-byte key (raw or base64) for voucher redeem codes at rest.
# Generate: openssl rand -base64 32
# The value below is a local demo key. Replace it in production.
REWARDS_ENCRYPTION_KEY=liveline-pro-local-dev-key-32b!!

# Optional S3-compatible media storage. Empty = local ./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Process roles
NODE_ENV=development
PORT=3001
# Set false on the API service when a separate worker service is running.
RUN_EMBEDDED_WORKER=true
# Required to call /internal/* (disabled entirely when NODE_ENV=production).
INTERNAL_SERVICE_TOKEN=local-dev-internal-token
WORKER_HEALTH_PORT=3002
BOT_HEALTH_PORT=3003
